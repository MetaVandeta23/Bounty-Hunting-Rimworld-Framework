<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <QuestScriptDef>
    <defName>META_HuntingMadAnimals</defName>
    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>350</rootMinPoints>
    <questNameRules>
      <rulesStrings>
        <li>questName->Hunting: Mad [animalKind_labelPlural]</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription(Scaria==False,asker_factionLeader==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, [asker_faction_leaderTitle] of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has contacted us with a contract.\n\nA pack of [animalCount] [animalKind_labelPlural] have entered a localized manhunting state and are attacking anything nearby.\n\nThey are currently terrorizing the region and pose a serious danger to nearby travelers and settlements. &lt;color=#D09B61FF&gt;[asker_nameDef]&lt;/color&gt; wants you to travel to their nearby location and exterminate the entire pack before they wander off.</li>
        <li>questDescription(Scaria==True,asker_factionLeader==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, [asker_faction_leaderTitle] of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has contacted us with a contract.\n\nA pack of [animalCount] [animalKind_labelPlural] have been driven into a violent manhunting rage and are suffering from advanced scaria infection.\n\nThey are currently ravaging the surrounding region and present an immediate threat to all nearby settlements. &lt;color=#D09B61FF&gt;[asker_nameDef]&lt;/color&gt; wants the creatures eliminated before the infection spreads further.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_Set">
          <name>points</name>
          <value>$(randInt(600, 1200))</value>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_AdjustPointsForDistantFight</def>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GetDefaultRewardValueFromPoints</def>
        </li>
        <li Class="QuestNode_GetMap" />
        <li Class="BountiesMod.QuestNode_GetEnemyFactionLeader">
          <faction>$faction</faction>
          <storeAs>asker</storeAs>
        </li>

        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>

        <li Class="QuestNode_RandomNode">
          <nodes>
            <li Class="QuestNode_Sequence">
              <nodes>
                <li Class="QuestNode_Set">
                  <name>Scaria</name>
                  <value>True</value>
                </li>
                <li Class="QuestNode_Set">
                  <name>sitePartTag</name>
                  <value>META_BountyMadAnimalsScaria</value>
                </li>
              </nodes>
            </li>
            <li Class="QuestNode_Sequence">
              <nodes>
                <li Class="QuestNode_Set">
                  <name>Scaria</name>
                  <value>False</value>
                </li>
                <li Class="QuestNode_Set">
                  <name>sitePartTag</name>
                  <value>META_BountyMadAnimalsNoScaria</value>
                </li>
              </nodes>
            </li>
          </nodes>
        </li>

        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>$sitePartTag</tag>
            </li>
          </sitePartsTags>
        </li>

        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>

        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>

        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>

        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>720000</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <destroyOnCleanup>true</destroyOnCleanup>
          <node Class="QuestNode_End">
            <outcome>Fail</outcome>
            <sendStandardLetter>true</sendStandardLetter>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.Destroyed</inSignal>
          <node Class="QuestNode_End">
            <outcome>Fail</outcome>
            <sendStandardLetter>true</sendStandardLetter>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_GiveRewards">
                <parms>
                  <allowGoodwill>true</allowGoodwill>
                  <allowRoyalFavor>true</allowRoyalFavor>
                  <thingRewardRequired>true</thingRewardRequired>
                  <minGeneratedRewardValue>$bountyReward</minGeneratedRewardValue>
                </parms>
              </li>
              <li Class="QuestNode_End">
                <outcome>Success</outcome>
                <sendStandardLetter>true</sendStandardLetter>
              </li>
            </nodes>
          </node>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

