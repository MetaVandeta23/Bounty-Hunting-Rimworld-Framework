  <QuestScriptDef>
    <defName>META_Retrieval</defName>
    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>350</rootMinPoints>
    <questNameRules>
      <rulesStrings>
        <li>questName->Retrieval: [ItemName]</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription(asker_factionLeader==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, [asker_faction_leaderTitle] of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has acquired intelligence regarding the location of a valuable asset.\n\nThe target object is identified as &lt;color=#E6E64CFF&gt;[ItemName]&lt;/color&gt;.\n\nThe item is believed to be located somewhere nearby, although hostile resistance or environmental dangers may be present.\n\n&lt;color=#D09B61FF&gt;[asker_nameDef]&lt;/color&gt; wants the item retrieved and delivered intact.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_Set">
          <name>points</name>
          <value>$(randInt(600, 1200))</value>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GetDefaultRewardValueFromPoints</def>
        </li>
        <li Class="QuestNode_GetMap" />
        <li Class="BountiesMod.QuestNode_GetEnemyFactionLeader">
          <faction>$faction</faction>
          <storeAs>asker</storeAs>
        </li>
        <li Class="QuestNode_GetFactionOf">
          <thing>$asker</thing>
          <storeAs>askerFaction</storeAs>
        </li>
        <li Class="BountiesMod.QuestNode_GenerateRetrievalItem">
          <storeAs>item</storeAs>
        </li>
        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>META_BountyItemStash</tag>
            </li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>
        <li Class="BountiesMod.QuestNode_SetupBountyDelivery">
          <targetItem>$item</targetItem>
          <askerFaction>$askerFaction</askerFaction>
          <site>$site</site>
        </li>
        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>720000</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <destroyOnCleanup>true</destroyOnCleanup>
          <node Class="QuestNode_End">
            <outcome>Fail</outcome>
            <sendStandardLetter>true</sendStandardLetter>
          </node>
        </li>
        <li Class="QuestNode_Signal">
          <inSignal>item.Destroyed</inSignal>
          <node Class="QuestNode_End">
            <outcome>Fail</outcome>
            <sendStandardLetter>true</sendStandardLetter>
          </node>
        </li>
        <li Class="QuestNode_AnySignal">
          <inSignals>
            <li>$outDelivered</li>
          </inSignals>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_GiveRewards">
                <parms>
                  <allowGoodwill>true</allowGoodwill>
                  <allowRoyalFavor>true</allowRoyalFavor>
                  <thingRewardRequired>true</thingRewardRequired>
                  <minGeneratedRewardValue>$bountyReward</minGeneratedRewardValue>
                </parms>
              </li>
              <li Class="QuestNode_End">
                <outcome>Success</outcome>
                <sendStandardLetter>true</sendStandardLetter>
              </li>
            </nodes>
          </node>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <QuestScriptDef>
    <defName>META_BountyTarget</defName>
    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>350</rootMinPoints>
    <questNameRules>
      <rulesStrings>
        <li>questName(CaptureAlive==True)->Bounty: [target_nameDef] the Fugitive</li>
        <li>questName(DeadOrAlive==True)->Bounty: [target_nameDef]</li>
        <li>questName(DeadPreferred==True)->Execution Contract: [target_nameDef]</li>
        <li>questName(AlivePreferred==True)->Bounty: [target_nameDef]</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription(asker_factionLeader==True,CaptureAlive==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has issued a live-capture warrant for [target_nameFull].\n\nIntelligence reports place [target_nameDef] at a nearby hostile site protected by armed guards.\n\nThe client requires the target returned alive to face interrogation and sentencing. Lethal force against defenders is fully authorized, but if [target_nameDef] dies, the contract will immediately fail.</li>
        <li>questDescription(asker_factionLeader==True,DeadOrAlive==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has placed a bounty on [target_nameFull].\n\n[target_nameDef] has been located at a nearby encampment under armed protection.\n\nThe client authorizes either live capture or lethal termination. Full payment will be provided whether the target is returned breathing or dead.\n\n&lt;color=#D09B61FF&gt;Warning:&lt;/color&gt; If the target is killed, the corpse must remain intact for positive identification.</li>
        <li>questDescription(asker_factionLeader==True,AlivePreferred==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has authorized a bounty contract for [target_nameFull].\n\n[target_nameDef] is currently hiding at a nearby hostile location guarded by loyal defenders.\n\nThe client strongly prefers the target captured alive for questioning and public sentencing. However, lethal force is authorized if capture becomes impossible.</li>
        <li>questDescription(asker_factionLeader==True,DeadPreferred==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has issued a termination contract for [target_nameFull].\n\n[target_nameDef] has become a major threat to regional stability and negotiations are no longer considered viable.\n\nThe target has been tracked to a nearby fortified position. The client requires definitive proof of death and authorizes unrestricted lethal force.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_Set">
          <name>points</name>
          <value>$(randInt(600, 1200))</value>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
        </li>
        <li Class="QuestNode_SubScript">
