  <QuestScriptDef>
    <defName>META_ContractLeader</defName>
    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>350</rootMinPoints>
    <questNameRules>
      <rulesStrings>
        <li>questName->Contract: [leader_nameFull]</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription(asker_factionLeader==True,CaptureAlive==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has issued a high-priority live-capture contract against &lt;color=#FF3333FF&gt;[siteFaction_name]&lt;/color&gt;.\n\nIntelligence reports confirm that [leader_nameFull], leader of [siteFaction_name], is currently visiting a nearby settlement to inspect local defenses.\n\n&lt;color=#D09B61FF&gt;[asker_nameDef]&lt;/color&gt; wants you to infiltrate the site and capture [leader_nameDef] alive. Lethal force against defenders is authorized, but the target must survive.\n\nHeavy resistance is expected.</li>
        <li>questDescription(asker_factionLeader==True,DeadOrAlive==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has issued a high-priority contract against &lt;color=#FF3333FF&gt;[siteFaction_name]&lt;/color&gt;.\n\nIntelligence reports confirm that [leader_nameFull], leader of [siteFaction_name], is currently visiting a nearby settlement to inspect local defenses.\n\n&lt;color=#D09B61FF&gt;[asker_nameDef]&lt;/color&gt; wants you to infiltrate the site and either capture or eliminate [leader_nameDef]. The target or their corpse must be returned to any of our settlements to collect the reward.\n\nHeavy resistance is expected.</li>
        <li>questDescription(asker_factionLeader==True,AlivePreferred==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has issued a high-priority contract against &lt;color=#FF3333FF&gt;[siteFaction_name]&lt;/color&gt;.\n\nIntelligence reports confirm that [leader_nameFull], leader of [siteFaction_name], is currently visiting a nearby settlement to inspect local defenses.\n\n&lt;color=#D09B61FF&gt;[asker_nameDef]&lt;/color&gt; strongly prefers the target captured alive for questioning, but lethal force is authorized if capture becomes impossible.\n\nReturning the corpse instead of a living prisoner will reduce the final reward.\n\nHeavy resistance is expected.</li>
        <li>questDescription(asker_factionLeader==True,DeadPreferred==True)->&lt;color=#D09B61FF&gt;[asker_nameFull]&lt;/color&gt;, of &lt;color=#00BFFFFF&gt;[asker_faction_name]&lt;/color&gt;, has issued a high-priority termination contract against &lt;color=#FF3333FF&gt;[siteFaction_name]&lt;/color&gt;.\n\nIntelligence reports confirm that [leader_nameFull], leader of [siteFaction_name], is currently visiting a nearby settlement to inspect local defenses.\n\n&lt;color=#D09B61FF&gt;[asker_nameDef]&lt;/color&gt; requires definitive proof of death. You must infiltrate the site, eliminate [leader_nameDef], and return the corpse.\n\nHeavy resistance is expected.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_Set">
          <name>points</name>
          <value>$(randInt(800, 1500))</value>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GetDefaultRewardValueFromPoints</def>
        </li>
        <li Class="QuestNode_GetMap" />
        <li Class="BountiesMod.QuestNode_GetEnemyFactionLeader">
          <faction>$faction</faction>
          <storeAs>asker</storeAs>
        </li>
        <li Class="QuestNode_GetFactionOf">
          <thing>$asker</thing>
          <storeAs>askerFaction</storeAs>
        </li>
        <li Class="QuestNode_GetFaction">
          <storeAs>siteFaction</storeAs>
          <allowEnemy>true</allowEnemy>
          <mustBePermanentEnemy>true</mustBePermanentEnemy>
        </li>
        <li Class="BountiesMod.QuestNode_GetEnemyFactionLeader">
          <faction>$siteFaction</faction>
          <storeAs>leader</storeAs>
        </li>
        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <sitePartsTags>
            <li>
              <tag>META_BountyLeaderBase</tag>
            </li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>
        <li Class="BountiesMod.QuestNode_SetupBountyContract">
          <target>$leader</target>
          <askerFaction>$askerFaction</askerFaction>
          <site>$site</site>
        </li>
        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>720000</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <destroyOnCleanup>true</destroyOnCleanup>
          <node Class="QuestNode_End">
            <outcome>Fail</outcome>
            <sendStandardLetter>true</sendStandardLetter>
          </node>
        </li>
        <li Class="QuestNode_AnySignal">
          <inSignals>
            <li>$outDeliveredAlive</li>
            <li>$outDeliveredDead</li>
          </inSignals>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_GiveRewards">
                <parms>
                  <allowGoodwill>true</allowGoodwill>
                  <allowRoyalFavor>true</allowRoyalFavor>
                  <thingRewardRequired>true</thingRewardRequired>
                  <minGeneratedRewardValue>$bountyReward</minGeneratedRewardValue>
                </parms>
              </li>
              <li Class="QuestNode_End">
                <outcome>Success</outcome>
                <sendStandardLetter>true</sendStandardLetter>
              </li>
            </nodes>
          </node>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

