<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <SitePartDef>
    <defName>META_BountyMadAnimalsScaria</defName>
    <label>mad animals pack</label>
    <description>A pack of mad animals.</description>
    <workerClass>BountiesMod.SitePartWorker_BountyMadAnimals</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Manhunters</expandingIconTexture>
    <wantsThreatPoints>true</wantsThreatPoints>
    <tags>
      <li>META_BountyMadAnimalsScaria</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>META_BountyMadAnimalsScaria</defName>
    <linkWithSite>META_BountyMadAnimalsScaria</linkWithSite>
    <order>1600</order>
    <genStep Class="BountiesMod.GenStep_BountyAnimalsScaria" />
  </GenStepDef>

  <SitePartDef>
    <defName>META_BountyMadAnimalsNoScaria</defName>
