    <tags>
      <li>META_BountyMadAnimalsNoScaria</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>META_BountyMadAnimalsNoScaria</defName>
    <linkWithSite>META_BountyMadAnimalsNoScaria</linkWithSite>
    <order>1600</order>
    <genStep Class="BountiesMod.GenStep_BountyAnimalsNoScaria" />
  </GenStepDef>

  <SitePartDef>
    <defName>META_BountyExoticAnimals</defName>
    <label>exotic animals pack</label>
    <description>A pack of exotic animals.</description>
    <workerClass>BountiesMod.SitePartWorker_BountyExoticAnimals</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Manhunters</expandingIconTexture>
    <wantsThreatPoints>true</wantsThreatPoints>
